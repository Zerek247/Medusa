# --- Solo para desarrollo local en Docker. NUNCA credenciales reales. ---
# Copia este archivo a ".env" en esta misma carpeta (queda fuera de git)
# para tener tu copia editable. Los valores de aquí ya funcionan tal cual
# contra el docker-compose.yml de la raíz del repo.

# Controla el flujo de "primeros pasos" que muestra el admin de Medusa la
# primera vez que entras (tour guiado, checklist, etc). "default" es el
# comportamiento estándar de Medusa.
MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Cadena de conexión a Postgres. "postgres" es el nombre del servicio en
# docker-compose.yml (no "localhost"): dentro de la red interna de Docker,
# Compose resuelve ese nombre por DNS al contenedor correspondiente.
# Formato: postgres://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgres://medusa:medusa_dev_password@postgres:5432/medusa_store

# En "true" solo en un Postgres administrado que exija SSL (Railway, Fase
# 6B) -- déjalo vacío/false en local, Postgres en Docker no habla SSL.
DATABASE_SSL=false

# URL de Redis, usada por projectConfig.redisUrl (cache/sesión interna del
# framework) y referenciada de nuevo en medusa-config.ts para los módulos
# de cache/event-bus/workflow-engine. Mismo razonamiento que DATABASE_URL:
# "redis" es el nombre del servicio, no localhost.
REDIS_URL=redis://redis:6379

# Orígenes permitidos por CORS para cada superficie de la API. Sin el
# origen correcto aquí, el navegador bloquea las peticiones aunque el
# backend responda bien.
# STORE_CORS  -> quién puede llamar a la API de tienda (/store/*): el storefront Next.js.
# ADMIN_CORS  -> quién puede llamar a la API de admin (/admin/*): el propio dashboard (9000) y su servidor Vite de HMR (5173).
# AUTH_CORS   -> quién puede llamar a /auth/*: la unión de los dos anteriores.
STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,https://docs.medusajs.com

# Secreto para firmar los JWT de sesión de la API. "supersecret" es el
# valor de desarrollo documentado por Medusa -- para producción, Medusa
# exige explícitamente un valor propio (no cae a este default).
JWT_SECRET=supersecret

# Secreto para firmar las cookies de sesión del admin. Mismo criterio que
# JWT_SECRET: válido solo para desarrollo local.
COOKIE_SECRET=supersecret

# Llave usada para cifrar los secretos de MFA (autenticación en dos pasos)
# de los usuarios admin en la base de datos. Generada una sola vez por
# create-medusa-app; no necesitas cambiarla para desarrollo local.
AUTH_MFA_ENCRYPTION_KEY=e19d4c66a5349caabade3c30ec08903018d4ae94f3973fbe525a6b6b3f923e1b

# --- Fase 3: separación server/worker ---
# "server" | "worker" | "shared". docker-compose.yml sobreescribe esto por
# contenedor (backend=server, worker=worker) -- este valor de acá es el
# default si corrieras el backend suelto, sin Compose.
WORKER_MODE=server
# En "true" apaga el dashboard de admin (el contenedor worker lo pone en
# true vía docker-compose.yml). Ver medusa-config.ts.
ADMIN_DISABLED=false

# --- Fase 3: cliente hacia el mock de Bind ERP ---
# "mock-bind" es el nombre del servicio en docker-compose.yml -- mismo
# razonamiento que DATABASE_URL/REDIS_URL de arriba.
BIND_BASE_URL=http://mock-bind:4001
# Debe coincidir EXACTO con BIND_API_KEY del .env de la raíz del repo (esa
# es la que usa el propio mock para exigir el header X-Api-Key).
BIND_API_KEY=bind-mock-key-local
# Cron de 5 campos para el job programado (src/jobs/sync-bind-catalog.ts).
# Default: cada 15 minutos.
BIND_SYNC_CRON=*/15 * * * *
# Cuántos productos se piden por página al listar el catálogo de Bind.
BIND_SYNC_PAGE_SIZE=20
# Milisegundos de espera entre una página y la siguiente al consultar Bind
# -- así se respeta su límite de tasa desde el lado del cliente.
BIND_SYNC_BATCH_DELAY_MS=400

# --- Fase 4: proveedor de envíos Skydropx ---
# "mock-skydropx" es el nombre del servicio en docker-compose.yml.
SKYDROPX_BASE_URL=http://mock-skydropx:4002
# Debe coincidir EXACTO con SKYDROPX_API_TOKEN del .env de la raíz.
SKYDROPX_API_TOKEN=skydropx-mock-token-local
# Código postal de la bodega/negocio, usado como origen en cada cotización.
SKYDROPX_CP_ORIGEN=01000

# --- Fase 5: PAC de CFDI (mock) ---
CFDI_BASE_URL=http://mock-cfdi:4003
# Debe coincidir EXACTO con CFDI_API_KEY del .env de la raíz.
CFDI_API_KEY=cfdi-mock-key-local
# RFC/nombre del NEGOCIO (emisor) que se manda a timbrar. Valor de PRUEBA
# fijo -- este prototipo nunca timbra ante el SAT de verdad (ver el
# comentario al inicio de apps/mock-cfdi/src/index.js).
CFDI_EMISOR_RFC=AAA010101AAA
CFDI_EMISOR_NOMBRE=Negocio de Prueba SA de CV

# --- Fase 5: Stripe (modo de PRUEBA -- nunca llaves reales) ---
# Tu llave SECRETA de prueba (empieza con sk_test_). Se obtiene gratis
# creando una cuenta de Stripe y activando el "modo de prueba" (toggle en
# el dashboard) -- ver el README, sección "Pagos con Stripe (Fase 5)".
STRIPE_API_KEY=
# El "signing secret" del webhook (empieza con whsec_). En desarrollo local
# lo genera el Stripe CLI al correr:
#   stripe listen --forward-to localhost:9000/hooks/payment/stripe_stripe
# (imprime un whsec_... distinto cada vez que lo corres -- hay que
# actualizarlo aquí y reiniciar el backend cada vez).
STRIPE_WEBHOOK_SECRET=

# --- Fase 5: cola de tareas post-pago (BullMQ sobre Redis) ---
# Milisegundos de espera antes de cada reintento -- 30s, 2min, 10min, tal
# cual lo pidió el negocio. Se puede acortar temporalmente para probar más
# rápido (ej. "5000,10000,15000"), pero el valor real de producción es este.
POST_PAGO_BACKOFF_MS=30000,120000,600000
# Cuántas tareas procesa el worker EN PARALELO. 1 a propósito -- ver el
# comentario grande en src/modules/cola-post-pago/procesador.ts sobre la
# carrera que evita mantenerlo en 1.
POST_PAGO_CONCURRENCIA=1
