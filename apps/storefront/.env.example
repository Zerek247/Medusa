# --- Solo para desarrollo local en Docker. NUNCA credenciales reales. ---

# Publishable API key de la tienda. Es "publicable" por diseño (Medusa la
# expone al navegador a propósito, no es un secreto) y este valor
# corresponde a la base de datos de ESTE repo tal cual la genera el seed
# inicial. Si reconstruiste la base de datos desde cero (docker compose
# down -v) y el login de la tienda falla, la key cambió -- consulta la
# nueva con:
#   docker compose exec backend sh -c "cd apps/backend && npx medusa exec ./src/scripts/mostrar-publishable-key.ts"
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_def726b4ab432734ec0a7923590e5946ce8fb5878fc08356f264e70d3bc2b35d

# URL del backend que usa TU NAVEGADOR (fuera de Docker) -- el puerto
# publicado en docker-compose.yml.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# URL del backend que usa el CONTENEDOR del storefront (renderizado en
# servidor de Next.js) -- el nombre de servicio de Docker Compose. Sin el
# prefijo NEXT_PUBLIC_ a propósito: nunca debe llegar al navegador. Ver el
# comentario en src/lib/config.ts.
MEDUSA_BACKEND_URL_INTERNAL=http://backend:9000

# Código de país por defecto -- debe existir como país de alguna región en
# Medusa (nuestra región "México" tiene el país "mx").
NEXT_PUBLIC_DEFAULT_REGION=mx

# URL pública del storefront mismo (para generar URLs absolutas).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Fase 5: llave PUBLICABLE de prueba de Stripe (empieza con pk_test_, no es
# secreta -- viaja al navegador a propósito, así funciona Stripe Elements).
# Ver el README, sección "Pagos con Stripe (Fase 5)".
NEXT_PUBLIC_STRIPE_KEY=

# --- Fase 6B: modo demo ---
# En "true": banner permanente, checkout con confirmación simulada (nunca
# llama a Stripe), registro de cuentas nuevas deshabilitado, pie de página
# con leyenda de "propuesta visual". "false" para uso normal.
NEXT_PUBLIC_MODO_DEMO=false

NODE_ENV=development
