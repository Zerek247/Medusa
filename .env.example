# Variables leídas por docker-compose.yml para los mocks locales.
# Copia este archivo a ".env" (queda fuera de git) si quieres cambiar los
# valores. Son API keys DE PRUEBA para autenticar las llamadas ENTRE
# contenedores locales -- no corresponden a ninguna cuenta real de Bind
# ERP, Skydropx ni de un PAC.

# API key que exige el mock de Bind ERP en el header X-Api-Key.
BIND_API_KEY=bind-mock-key-local

# En "true", mock-bind hace fallar ~20% de sus peticiones con 500 al azar,
# para probar lógica de reintentos del lado de Medusa. Déjalo en "false"
# para uso normal.
SIMULATE_FAILURES=false

# Token que exige el mock de Skydropx en el header Authorization: Bearer.
SKYDROPX_API_TOKEN=skydropx-mock-token-local

# API key que exige el mock del PAC de CFDI en el header X-Api-Key.
CFDI_API_KEY=cfdi-mock-key-local
