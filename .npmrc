# pnpm a veces necesita purgar node_modules cuando el lockfile cambia
# mucho (por ejemplo, al agregar el storefront con ~370 paquetes nuevos de
# golpe) y normalmente pregunta antes de hacerlo. Dentro de Docker no hay
# terminal interactiva para responder esa pregunta, así que sin esto la
# instalación aborta con [ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY].
confirmModulesPurge=false
